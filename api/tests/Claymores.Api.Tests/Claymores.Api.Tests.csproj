  <ItemGroup>
    <!-- Pages saved from rugbyfl.com on 2026-11-23 for the scraper parser tests. -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Claymores.Api\Claymores.Api.csproj" />
  </ItemGroup>

</Project>